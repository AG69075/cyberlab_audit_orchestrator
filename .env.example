# Copier en .env et remplir. Aucune valeur réelle ici.

# Secret partagé avec le Worker Cloudflare (cyberlab-audit-proxy), exigé sur
# toutes les routes /api. Générer avec: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Token du tunnel Cloudflare (container `cloudflared`, pas lu par app.js).
TUNNEL_TOKEN=

# Optionnelle : absente => ai.available=false, findings déterministes seuls.
GEMINI_API_KEY=
# Les noms de modèles "flash" de Google changent souvent ; ajuster si 404/503.
GEMINI_MODEL=gemini-3.6-flash

# Base URL interne du service dns_analyzer (réseau docker-compose par défaut)
# + son propre INTERNAL_API_TOKEN, pour la phase active (sous-domaines).
# Absent => la phase active saute discovery des sous-domaines.
DNS_ANALYZER_BASE_URL=http://dns-analyzer:4002
DNS_ANALYZER_INTERNAL_TOKEN=

# Origines autorisées en CORS (liste séparée par des virgules).
ALLOWED_ORIGINS=https://aginepro.work,https://cyberlab.aginepro.work

PORT=4003
